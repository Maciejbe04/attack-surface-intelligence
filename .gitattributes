# Keep Unix line endings for files executed inside Linux containers.
# Without this, Git for Windows (core.autocrlf=true) checks them out with CRLF
# and the containers fail with "exec format error" or "bash\r: not found".
* text=auto
*.sh text eol=lf
Dockerfile* text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.hcl text eol=lf
