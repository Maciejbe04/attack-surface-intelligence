# Copy to .env — do not commit .env
COMPOSE_PROJECT_NAME=surfacex

# Published gateway only
# Change if 8080 is already taken on the host
GATEWAY_HTTP_PORT=8080

# Resource hints (override locally as needed)
API_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=256m

# Application
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gateway,api
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:18080,http://127.0.0.1:18080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:18080,http://127.0.0.1:18080
SECURE_COOKIES=0
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme
REDIS_URL=redis://redis:6379/2

# Postgres (password comes from secrets/postgres_password)
POSTGRES_DB=surfacex
POSTGRES_USER=surfacex

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
SCAN_RECONCILE_INTERVAL_SECONDS=60
SCAN_RECONCILE_STALE_SECONDS=600
SCAN_RECONCILE_BATCH_LIMIT=100

# Worker → API
API_INTERNAL_URL=http://api:8000
WORKER_CONCURRENCY=2

# Global scan safety limits, shared by ALL scans whatever the UI filters say.
# Split evenly between SCAN_WORKER_SLOTS (total worker processes across all
# worker containers; defaults to WORKER_CONCURRENCY).
SCAN_MAX_RATE_TOTAL=300
SCAN_HTTP_RATE_TOTAL=100
# SCAN_WORKER_SLOTS=2

# MFA backend stays off until the rollout in docs/mfa-backend.md
MFA_ENABLED=0

# Optional embedded/external DefectDojo
DEFECTDOJO_HTTP_PORT=8081
DEFECTDOJO_URL=http://defectdojo:8080
DEFECTDOJO_USERNAME=admin
# For an external instance, set a dedicated API token instead of sharing a password:
# DEFECTDOJO_API_TOKEN=
DEFECTDOJO_ADMIN_EMAIL=admin@defectdojo.local
DEFECTDOJO_PRODUCT_TYPE=SurfaceX
DEFECTDOJO_PRODUCT_NAME=Attack Surface
DEFECTDOJO_ENGAGEMENT_NAME=SurfaceX Discovery
DEFECTDOJO_TEST_TITLE=SurfaceX Discovery
DEFECTDOJO_TIMEOUT_SECONDS=30
DEFECTDOJO_APP_MEMORY_LIMIT=1g
DEFECTDOJO_WORKER_MEMORY_LIMIT=1g

# ProjectDiscovery httpx pin (image build arg)
HTTPX_VERSION=v1.6.9
