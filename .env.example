# Copy to .env — do not commit .env
COMPOSE_PROJECT_NAME=surfacex

# Published gateway only
# Change if 8080 is already taken on the host
GATEWAY_HTTP_PORT=8080

# Resource hints (override locally as needed)
API_MEMORY_LIMIT=512m
WORKER_MEMORY_LIMIT=1g
POSTGRES_MEMORY_LIMIT=512m
REDIS_MEMORY_LIMIT=256m

# Application
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,gateway,api
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SECURE_COOKIES=0

# Postgres (password comes from secrets/postgres_password)
POSTGRES_DB=surfacex
POSTGRES_USER=surfacex

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Worker → API
API_INTERNAL_URL=http://api:8000
WORKER_CONCURRENCY=2

# ProjectDiscovery httpx pin (image build arg)
HTTPX_VERSION=v1.6.9
